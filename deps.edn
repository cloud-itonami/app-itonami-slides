{:paths ["src" "resources"]
 ;; Zero third-party runtime deps. Every namespace is portable .cljc for JVM,
 ;; ClojureScript, and SCI-style hosts.
 :deps {
        ;; kotoba.lang.error replaced clojure.lang.ExceptionInfo here (2026-09-25).
        ;; An explicit floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/error
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.error"}
        ;; kotoba.bytes replaced java.util.Base64 here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.bytes"}
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.io"}
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.coll"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.edn"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.text"}
       io.github.kotoba-lang/office
        {:git/url "https://github.com/kotoba-lang/office.git"
         :git/sha "b5838def811d05f1db1e7d77e5daede8ac953883"}
        io.github.kotoba-lang/ooxml
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.ooxml"}
        ;; Advanced to the pin sheets, docs and forms share. 0d45c30 was the
        ;; commit that moved the wire to plain JSON, so nothing here changes
        ;; behaviour — it stops this being the one office library resolving
        ;; a different transit than the other three.
        io.github.kotoba-lang/transit
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.transit"}
        io.github.kotoba-lang/drawingml
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.drawingml"}
        io.github.kotoba-lang/presentationml
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.presentationml"}
        io.github.kotoba-lang/office-style
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.officeStyle"}
        ;; kotoba-lang design-system paved road (ADR-2607122200): the app
        ;; requires kotoba-ui.core (single entry: shell/theme/->page + all
        ;; component aliases) + appkit.core (desktop/dense-data defaults).
        ;; These are :local/root west-sibling deps — kotoba-ui itself declares
        ;; shitsuke/liquid-glass-ui as :local/root, so the whole stack must be
        ;; pinned :local/root here too (git-sha vs :local/root coordinates for
        ;; the same lib are uncomparable and fail the classpath build — same
        ;; resolution as the appkit exemplar, gftdcojp/cloud-itonami#393).
        ;; CI clones these four siblings before running (see ci.yml).
        io.github.kotoba-lang/kotoba-ui
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.kotobaUi"}
        io.github.kotoba-lang/appkit
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.appkit"}
        io.github.kotoba-lang/liquid-glass-ui
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.liquidGlassUi"}
        ;; shitsuke: shared UI design system (tokens + hiccup + style +
        ;; portable re-frame seam + components). Pure .cljc, zero runtime deps.
        ;; :local/root (was :git/sha) — see the kotoba-ui note above; the
        ;; sibling main also carries the reagent-safe :on-input→:on-change
        ;; controlled-input fix (kotoba-lang/shitsuke PR #4) and shitsuke.hig.
        io.github.kotoba-lang/shitsuke
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.shitsuke"}
        ;; canvaskit: canvas/viewport interaction math, Apple HIG/UIKit
        ;; vocabulary (ADR-2607071130). slides.web.events uses the zoom-scale
        ;; clamp for the editor canvas zoom.
        io.github.kotoba-lang/canvaskit
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.canvaskit"}
        ;; kotoba-lang/css: CSS as EDN data. Used for the docs/main.css build
        ;; (build.clj) instead of a hand-typed static.css string.
        io.github.kotoba-lang/css
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.css"}
        io.github.kotoba-lang/xml
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "b94158fd48ec541b70d3c455912a06f407537ddc"
         :deps/root "lib/kotoba.xml"}}
 :aliases
 {:cli {:main-opts ["-m" "slides.cli"]}
  ;; Browser hydration bundle (slides.web.client → docs/js/main.js via
  ;; shadow-cljs, see shadow-cljs.edn). Real reagent + re-frame behind the
  ;; shitsuke host seams; same versions as the kami-mangaka-reader exemplar.
  :cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                      reagent/reagent {:mvn/version "1.2.0"}
                      re-frame/re-frame {:mvn/version "1.4.3"}
                      thheller/shadow-cljs {:mvn/version "2.28.20"}}}
  :local {:override-deps {io.github.kotoba-lang/office
                          {:local/root "../office"}
                          io.github.kotoba-lang/ooxml
                          {:local/root "../ooxml"}
                          io.github.kotoba-lang/drawingml
                          {:local/root "../drawingml"}
                          io.github.kotoba-lang/presentationml
                          {:local/root "../presentationml"}
                          io.github.kotoba-lang/office-style
                          {:local/root "../office-style"}
                          io.github.kotoba-lang/shitsuke
                          {:local/root "../shitsuke"}
                          io.github.kotoba-lang/kotoba-ui
                          {:local/root "../kotoba-ui"}
                          io.github.kotoba-lang/appkit
                          {:local/root "../appkit"}
                          io.github.kotoba-lang/liquid-glass-ui
                          {:local/root "../liquid-glass-ui"}
                          io.github.kotoba-lang/css
                          {:local/root "../css"}
                          io.github.kotoba-lang/xml
                          {:local/root "../xml"}}}
  :pages {:main-opts ["-m" "slides.build"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :coverage {:extra-paths ["test"]
             :extra-deps {cloverage/cloverage {:mvn/version "1.2.4"}
                          io.github.cognitect-labs/test-runner
                          {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
             :main-opts ["-m" "cloverage.coverage"
             "--ns-regex" "slides\\.(model|design|architecture|architecture-site|routes|render|validate|pptx|office|causal|svgraph|wire|hiccup|site|build|cli|web\\.(events|views|sample|ssr|dispatch|enhance))"
                         "--test-ns-regex" "slides\\..*-test"
                         "--src-ns-path" "src"
                         "--test-ns-path" "test"
                         "--output" "target/coverage"
                         "--no-html"
                         "--text"
                         "--lcov"
                         "--fail-threshold" "85"]}
  :coverage-thresholds {:extra-paths ["test"]
                        :main-opts ["-m" "slides.coverage-gate"]}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
